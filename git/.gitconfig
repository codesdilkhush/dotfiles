[init]
	defaultBranch = main

[user]
	name = Dilkhush Kumar
	email = codes.dilkhush@gmail.com

[core]
	editor = nvim
	autocrlf = input
	whitespace = fix

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[diff]
	colorMoved = zebra

[alias]
	st     = status
	lg     = log --oneline --graph --decorate --all
	undo   = reset --soft HEAD~1
	aliases = config --get-regexp alias
